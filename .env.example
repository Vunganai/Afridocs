# ============================================================
#  AfriDocs AI — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ── App ──────────────────────────────────────────────────────
APP_ENV=development            # development | staging | production
APP_SECRET_KEY=change-me-to-a-random-64-char-string
LOG_LEVEL=INFO

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database URL (Supabase connection pooler — Transaction mode)
DATABASE_URL=postgresql+asyncpg://postgres.your-project-ref:your-password@aws-0-af-south-1.pooler.supabase.com:6543/postgres

# ── Redis (Upstash for prod; local redis for dev) ─────────────
REDIS_URL=redis://localhost:6379/0
# Upstash example: rediss://:your-token@your-host.upstash.io:6379

# ── Azure AI Document Intelligence ───────────────────────────
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-doc-intel-key

# ── Azure OpenAI ─────────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Azure Blob Storage (document originals) ───────────────────
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
AZURE_STORAGE_CONTAINER_NAME=afridocs-documents

# ── File Upload Limits ────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/tiff

# ── Celery ───────────────────────────────────────────────────
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend (Vite env vars — must be prefixed VITE_) ─────────
# Copy these into frontend/.env.local
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000
